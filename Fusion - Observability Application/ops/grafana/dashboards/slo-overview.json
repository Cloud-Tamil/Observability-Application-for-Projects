{
  "uid": "slo-overview",
  "title": "Fusion Metrics — SLO Overview",
  "tags": ["fusion", "slo"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "type": "stat", "id": 1, "title": "Availability (5m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "orange", "value": 0.995 },
            { "color": "green", "value": 0.999 } ] }
        }, "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "job:fusion_slo_availability:5m", "refId": "A" }]
    },
    {
      "type": "stat", "id": 2, "title": "Burn Rate (5m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "fieldConfig": {
        "defaults": { "unit": "x", "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 6 },
            { "color": "red", "value": 14.4 } ] }
        }, "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "job:fusion_slo_burn_rate:5m", "refId": "A" }]
    },
    {
      "type": "stat", "id": 3, "title": "p95 Latency (5m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 0.5 },
            { "color": "red", "value": 1.0 } ] }
        }, "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "job:fusion_latency_p95:5m", "refId": "A" }]
    },
    {
      "type": "stat", "id": 4, "title": "Traffic (req/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "job:fusion_request_rate:5m", "refId": "A" }]
    },
    {
      "type": "timeseries", "id": 10, "title": "Latency percentiles",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s",
        "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8,
                    "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right",
        "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(fusion_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(fusion_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(fusion_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "type": "timeseries", "id": 11, "title": "Request rate by status",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps",
        "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8,
                    "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right",
        "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "sum by (status_code) (rate(fusion_http_requests_total[1m]))",
        "legendFormat": "{{status_code}}", "refId": "A" }]
    }
  ]
}
