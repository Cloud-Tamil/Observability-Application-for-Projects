pipeline {
    agent any

    environment {
        REGISTRY = "${env.DOCKER_REGISTRY ?: 'docker.io'}/${env.IMAGE_PREFIX ?: 'shopsphere'}"
        TAG      = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'ls -la'
            }
        }

        stage('Install Dependencies') {
            parallel {
                stage('auth-service')  { steps { dir('auth-service')  { sh 'npm install --no-audit --no-fund' } } }
                stage('user-service')  { steps { dir('user-service')  { sh 'npm install --no-audit --no-fund' } } }
                stage('order-service') { steps { dir('order-service') { sh 'npm install --no-audit --no-fund' } } }
                stage('api-gateway')   { steps { dir('api-gateway')   { sh 'npm install --no-audit --no-fund' } } }
                stage('frontend')      { steps { dir('frontend')      { sh 'npm install --no-audit --no-fund && npm run build' } } }
            }
        }

        stage('Build Images') {
            steps {
                sh "docker build -t ${REGISTRY}/auth-service:${TAG}  ./auth-service"
                sh "docker build -t ${REGISTRY}/user-service:${TAG}  ./user-service"
                sh "docker build -t ${REGISTRY}/order-service:${TAG} ./order-service"
                sh "docker build -t ${REGISTRY}/api-gateway:${TAG}   ./api-gateway"
                sh "docker build -t ${REGISTRY}/frontend:${TAG}      ./frontend"
            }
        }

        stage('Push Images') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DU', passwordVariable: 'DP')]) {
                    sh 'echo $DP | docker login -u $DU --password-stdin'
                    sh "docker push ${REGISTRY}/auth-service:${TAG}"
                    sh "docker push ${REGISTRY}/user-service:${TAG}"
                    sh "docker push ${REGISTRY}/order-service:${TAG}"
                    sh "docker push ${REGISTRY}/api-gateway:${TAG}"
                    sh "docker push ${REGISTRY}/frontend:${TAG}"
                }
            }
        }

        stage('Update Manifests') {
            steps {
                sh """
                    sed -i 's|shopsphere/auth-service:.*|shopsphere/auth-service:${TAG}|'   k8s/auth-service/deployment.yaml
                    sed -i 's|shopsphere/user-service:.*|shopsphere/user-service:${TAG}|'   k8s/user-service/deployment.yaml
                    sed -i 's|shopsphere/order-service:.*|shopsphere/order-service:${TAG}|' k8s/order-service/deployment.yaml
                    sed -i 's|shopsphere/api-gateway:.*|shopsphere/api-gateway:${TAG}|'     k8s/api-gateway/deployment.yaml
                    sed -i 's|shopsphere/frontend:.*|shopsphere/frontend:${TAG}|'           k8s/frontend/deployment.yaml
                """
            }
        }

        stage('Deploy') {
            steps {
                sh 'kubectl apply -f k8s/ --recursive || true'
            }
        }
    }

    post {
        success { echo "✅ Build #${BUILD_NUMBER} succeeded" }
        failure { echo "❌ Build #${BUILD_NUMBER} failed" }
    }
}