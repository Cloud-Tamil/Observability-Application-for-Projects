# ---------- Postgres ----------
POSTGRES_USER=shopsphere
POSTGRES_PASSWORD=shopsphere
POSTGRES_DB=shopsphere

# ---------- Server ----------
# Local dev (server on host, DB via Docker): localhost
# Docker Compose overrides this to use the `db` hostname.
DATABASE_URL=postgresql://shopsphere:shopsphere@localhost:5432/shopsphere?schema=public
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# Minimum 16 chars each. CHANGE THESE IN PRODUCTION.
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32ch
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-32ch
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---------- Web ----------
VITE_API_URL=http://localhost:4000
